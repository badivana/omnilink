# OmniLink Server Environment Configuration
# Run `setup.bat` (Windows) or `sh setup.sh` (Linux) to generate this automatically,
# or copy this file to `.env` and fill in your values.

# 32-byte URL-safe base64 key for encrypting secrets at rest (Fernet.generate_key())
OMNILINK_ENCRYPTION_KEY=replace_with_fernet_generated_key_32_bytes=

# Bootstrap administrator credentials for initial login at `/`
OMNILINK_BOOTSTRAP_EMAIL=admin@example.com
OMNILINK_BOOTSTRAP_PASSWORD=replace_with_min_12_char_password

# Database URL: SQLite (default) or PostgreSQL (e.g. postgresql://user:pass@localhost:5432/omnilink)
OMNILINK_DATABASE_URL=sqlite:///./data/omnilink.db

# Publicly reachable URL where users access the server (used for CSRF and Origin checks)
# Replace with your LAN IP (e.g. https://192.168.1.50:8000) or public domain
OMNILINK_PUBLIC_URL=https://127.0.0.1:8000
OMNILINK_SITE_ADDRESS=https://127.0.0.1:8000

# Set to true when serving over HTTPS/TLS, false if using plain HTTP
OMNILINK_SECURE_COOKIE=true

# HTTP Server Bindings
OMNILINK_HTTP_HOST=0.0.0.0
OMNILINK_HTTP_PORT=8000
OMNILINK_HTTP_TLS=true

# Native Binary Protocol (ONP) Bindings
OMNILINK_NATIVE_HOST=0.0.0.0

# Mosquitto MQTT Broker Integration
OMNILINK_MQTT_ENABLED=true
OMNILINK_MQTT_HOST=127.0.0.1
OMNILINK_MQTT_PORT=1884
OMNILINK_MQTT_PASSWORD=replace_with_random_64_char_hex_secret
OMNILINK_MQTT_ADMIN_USER=omnilink-admin
OMNILINK_MQTT_ADMIN_PASSWORD=replace_with_random_64_char_hex_secret

# Optional PostgreSQL password (if using Docker Compose)
POSTGRES_PASSWORD=replace_with_random_64_char_hex_secret

# Path to the separately packaged Web Client directory (relative or absolute)
OMNILINK_CLIENT_DIR=../OmniLink_WebClient_v0.6

# Optional: serial port of an Uno/Nano running ArduinoUno_Serial (e.g. COM7 or /dev/ttyUSB0).
# The server then starts the USB gateway itself and restarts it if the board is unplugged.
# The board's sketch holds the device ID and secret. Leave empty to disable.
OMNILINK_SERIAL_GATEWAY=
